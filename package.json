{
  "name": "ai-site-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,green \"vite\" \"wrangler dev\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ai_site_starter_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai_site_starter_db --remote",
    "typecheck": "concurrently -n backend,web,tests,eslint -c blue,green,yellow,red \"bun run typecheck:backend\" \"bun run typecheck:web\" \"bun run typecheck:tests\" \"bun run lint:fix\"",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write ./src",
    "format:check": "prettier --check .",
    "check:themes": "bun scripts/check-themes.ts",
    "audit": "bun audit --ignore=GHSA-67mh-4wv8-2f99",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run --project api",
    "test:unit": "vitest run --project unit",
    "test:web": "vitest run --project web",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@batthewz/r-ui-css": "^0.1.1",
    "@batthewz/r-ui-react-components": "^0.1.1",
    "@batthewz/r-ui-tw-merge": "^0.1.0",
    "@floating-ui/react": "0.27.20",
    "@hono/zod-validator": "0.9.1",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
